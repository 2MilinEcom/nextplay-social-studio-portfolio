# Safe template only. Keep actual secrets outside the source repository/archive.
# nextplay.py reads <data-root>/.env for <data-root>/products/<product>.
# Alternatively supply these variables in the launching environment.
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
OPENAI_ANALYSIS_MODEL=REPLACE_WITH_ACCESSIBLE_MODEL
OPENAI_TRANSCRIPTION_MODEL=REPLACE_WITH_TRANSCRIPTION_MODEL
NEXTPLAY_AI_MODEL=REPLACE_WITH_TIMELINE_MODEL
FFMPEG_BINARY=/ABSOLUTE/PATH/TO/ffmpeg
SCRAPER_FORCE_BITMAP_OVERLAYS=0
