# Server configuration only. Keep actual values out of source control.
OPENAI_API_KEY=
NEXTPLAY_COPY_MODEL=gpt-4.1-mini
NEXTPLAY_RESEARCH_MODEL=gpt-4.1-mini
NEXTPLAY_AI_MODEL=gpt-4.1-mini
# For network/cloud deployments: HTTPS origin and a 16+ character password.
NEXTPLAY_ORIGIN=http://127.0.0.1:8770
NEXTPLAY_PASSWORD=
PORT=8770
# Registered TikTok Login Kit / Content Posting developer application.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Instagram API with Instagram Login developer application.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Facebook Page publishing developer application.
META_CLIENT_ID=
META_CLIENT_SECRET=
# Set the supported Graph API version for your registered Meta apps.
META_API_VERSION=v25.0

# Login-based publishing bridge (recommended for a personal workspace).
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=
